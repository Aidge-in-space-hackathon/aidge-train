# Modèle du fichier .env (à copier en .env, jamais versionné). docker compose le lit automatiquement.
# Offres gratuites uniquement : aucune de ces clés ne doit être liée à un moyen de paiement.

# ---------------------------------------------------------------- plateforme
# AIDGE_UI_BIND=127.0.0.1
# AIDGE_UI_USERS=login:motdepasse
# AIDGE_MAX_UPLOAD_MB=500

# ---------------------------------------------------------------- assistant RAG : proxy LiteLLM
# Clé du proxy, choisie par vous : doit commencer par « sk- » (ex. sk- suivi de 32 caractères aléatoires)
LITELLM_MASTER_KEY=
# Principal : https://build.nvidia.com (clé « nvapi-... »)
NVIDIA_NIM_API_KEY=
# Secours 1 : https://console.mistral.ai (plan gratuit ; les requêtes peuvent servir à l'entraînement de Mistral)
MISTRAL_API_KEY=
# Secours 2 : https://console.groq.com (offre gratuite)
GROQ_API_KEY=

# ---------------------------------------------------------------- assistant RAG : recherche
# Embeddings et rerank : https://dash.voyageai.com (200 M de tokens offerts ; sans moyen de paiement : 3 req/min, 10K tokens/min)
VOYAGE_API_KEY=
# auto (Voyage si la clé est là, repli local sinon), voyage, ou local (fastembed, sans clé)
EMBEDDINGS_BACKEND=auto
